# Copy this file to .env and adjust values

# Sentence-transformers model to use for embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Directory where ChromaDB persists vector data
CHROMA_PERSIST_DIR=./chroma_data

# SQLite database file for app registry
DB_PATH=./apps.db

# Override Hugging Face model cache location (recommended in production)
# HF_HOME=/path/to/persistent/model-cache

# Disable outbound Hugging Face Hub calls after the model is cached.
# Set both to 1 in production — prevents startup network checks and suppresses
# the unauthenticated Hub warning.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
